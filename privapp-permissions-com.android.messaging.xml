<permissions>
    <privapp-permissions package="com.android.messaging">
        <!--
             RCS session-mode chat carries its content over MSRP, and the far end advertises its
             MSRP endpoint as an address on the IMS PDN (fd00::/8). That network is restricted:
             without this permission Network.bindSocket fails with EPERM and the session
             establishes over SIP but can never carry a message.
        -->
        <permission name="android.permission.CONNECTIVITY_USE_RESTRICTED_NETWORKS"/>
        <!--
             Lets the app read the full carrier configuration and subscription state rather than
             the filtered view offered to ordinary apps.
        -->
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
    </privapp-permissions>
</permissions>
